PORT=4000
DATABASE_URL="postgresql://user:password@localhost:5432/marwa_digital?schema=public"
JWT_SECRET="dev-secret-change-me"

# Public web app base URL — used to build absolute links inside emails, and to
# seed the CORS allowlist below.
WEB_URL="http://localhost:3000"

# Admin dashboard base URL — added to the CORS allowlist alongside WEB_URL.
ADMIN_URL="http://localhost:3001"

# Extra origins to allow (comma-separated), on top of WEB_URL/ADMIN_URL and
# localhost:3000/3001 (always allowed in development). Needed if the site is
# also served from e.g. a staging domain or a bare www./non-www. variant.
CORS_ALLOWED_ORIGINS=

# Shared with apps/web's REVALIDATE_SECRET — authenticates this API's calls
# to apps/web's POST /api/revalidate (the admin's "Clear Cache" button).
REVALIDATE_SECRET="dev-secret-change-me"

# Where contact-form inquiry notifications are sent. Falls back to
# Settings → General → Contact Email when unset.
INQUIRY_NOTIFY_EMAIL=

# Outgoing email. All of these are optional here — Admin → Settings → SMTP
# takes priority, and these are only the fallback when that hasn't been
# filled in. With neither source configured, sending is skipped and logged
# rather than failing the request.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# AI Content & SEO Assistant (text rewrite, SEO metadata, image alt text).
# Optional — every /api/admin/ai/* endpoint responds 503 "not configured"
# without it, everything else in the app works unaffected.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Vercel Blob storage — required when deploying to Vercel (a serverless
# function's filesystem doesn't persist between requests, so media uploads
# and backup archives need real remote storage instead of local disk).
# Create a Blob store in the Vercel dashboard's Storage tab; it auto-fills
# this env var into the project. Leave unset for local dev / any always-on
# host (Railway, a VPS) — uploads/backups fall back to local disk there.
BLOB_READ_WRITE_TOKEN=

# Authorizes calls to GET /api/cron/run-scheduled-tasks (resumes due
# workflow delays, promotes due scheduled Page/Post publishes) — only
# relevant on Vercel, where routes/cron.ts stands in for the setInterval
# pollers server.ts runs on an always-on host. Vercel automatically sends
# this as a Bearer token when it invokes a configured Cron Job (see
# vercel.json); for finer-than-daily scheduling on the Hobby plan, point a
# free external pinger (cron-job.org, a scheduled GitHub Action, etc.) at
# that same URL with this value as a `?secret=` query param or
# `X-Cron-Secret` header. Leave unset to disable the endpoint entirely
# (returns 503) — not needed on an always-on host.
CRON_SECRET=
