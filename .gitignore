# dependencies
node_modules/
.pnp
.pnp.js

# next.js
.next/
out/

# production
dist/

# generated by packages/api/scripts/build-vercel.mjs at deploy time
# (the api/index.js shim that loads it IS committed — see that file)
dist-vercel/
build/

# env
.env
.env*.local
!.env.example

# turbo
.turbo/

# vercel (local CLI project-link metadata — never shared/committed)
.vercel/

# expo (apps/driver, apps/passenger)
.expo/

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# prisma
packages/db/generated/

# editor
.vscode/*
!.vscode/extensions.json

# local e2e test scratch
e2e-shots/
e2e_booking.mjs
e2e_admin.mjs

# raw source-asset drop folder — production copies live in
# apps/web/public/images/, which is what actually gets committed
/images/

# raw source-content drop folder (.docx briefs) — the real copy now
# lives in code (seed.ts, page components), which is what gets committed
/pages content/

# admin-uploaded gallery images (runtime content, not source)
packages/api/uploads/

# local-only bundle of gitignored secrets/uploads for machine-to-machine
# transfer — must never be committed
/*_Local_Assets.zip

# pg_dump database backups (may contain real PII) — local-only
*_backup_*.sql

# System Backup & Disaster Recovery archives (contain full DB content +
# uploads, including hashed credentials) — local-only, never committed
packages/api/backups/
