{
  "name": "marwa-digital",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=6144 turbo run dev",
    "dev:admin": "cross-env NODE_OPTIONS=--max-old-space-size=6144 npm run dev --workspace=@marwa/admin",
    "dev:web": "cross-env NODE_OPTIONS=--max-old-space-size=6144 npm run dev --workspace=@marwa/web",
    "dev:api": "cross-env NODE_OPTIONS=--max-old-space-size=6144 npm run dev --workspace=@marwa/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "npm run test:e2e --workspace=@marwa/web && npm run test:e2e --workspace=@marwa/admin",
    "db:generate": "npm run generate --workspace=@marwa/db",
    "db:migrate": "npm run migrate --workspace=@marwa/db"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "turbo": "^2.3.0",
    "wait-on": "^9.1.0"
  },
  "packageManager": "npm@11.16.0",
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "htmlparser2": "9.1.0"
  }
}
